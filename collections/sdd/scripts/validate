#!/usr/bin/env bash
# SDD collection contract checks. Run from any directory.

set -u
cd "$(dirname "$0")/.." || exit 1
fail=0
count=0

for d in */; do
  [ -f "$d/SKILL.md" ] || continue
  count=$((count + 1))
  n=$(basename "$d")
  { head -1 "$d/SKILL.md" | grep -qx -- '---' \
    && grep -q "^name: $n$" "$d/SKILL.md" \
    && grep -q '^description: ' "$d/SKILL.md" \
    && grep -q '^license: MIT$' "$d/SKILL.md"; } \
    || { echo "NG frontmatter: $n"; fail=1; }
done

[ "$count" -eq 15 ] || { echo "NG skill count: $count (expected 15)"; fail=1; }
grep -q '9フェーズ' sdd/SKILL.md || { echo 'NG phase count: sdd'; fail=1; }
grep -q '現在9' sdd-maintain/SKILL.md || { echo 'NG phase count: sdd-maintain'; fail=1; }
grep -q '9フェーズ' README.md || { echo 'NG phase count: README'; fail=1; }

grep -q '現在フェーズ: constitution | specify | clarify | plan | tasks | analyze | implement | review | verify | 完了' \
  sdd/SKILL.md || { echo 'NG state.md phase values'; fail=1; }

for p in sdd-specify/template.md sdd-plan/template.md sdd-tasks/template.md \
         sdd-constitution/template.md sdd/spec-lite-template.md \
         sdd-implement/implementer-prompt.md; do
  [ -f "$p" ] || { echo "NG resource: $p"; fail=1; }
done

grep -q '統合方法の選択肢' sdd-verify/SKILL.md || { echo 'NG section: sdd-verify'; fail=1; }
grep -q '## 質問の優先順位' sdd-clarify/SKILL.md || { echo 'NG section: sdd-clarify'; fail=1; }
grep -q '## 変更の種類別チェックリスト' sdd-maintain/SKILL.md || { echo 'NG section: sdd-maintain checklist'; fail=1; }
grep -q '## 改善ループの回し方' sdd-maintain/SKILL.md || { echo 'NG section: sdd-maintain loop'; fail=1; }
grep -q '修正ループ: N/10' sdd/SKILL.md || { echo 'NG state.md repair loop'; fail=1; }
grep -q 'fix/skill-' sdd-troubleshoot/SKILL.md || { echo 'NG troubleshoot branch rule'; fail=1; }
grep -q '\[不具合却下\]' sdd-troubleshoot/SKILL.md || { echo 'NG troubleshoot rejection log'; fail=1; }

if rg -n '\.claude|CLAUDE\.md|bundle\.json|bundle:sdd|sdd-[a-z-]*sdd-' \
  -- */SKILL.md README.md AGENTS.md; then
  echo 'NG current docs contain legacy client-specific or malformed identifiers'
  fail=1
fi

for d in */; do
  [ -f "$d/SKILL.md" ] || continue
  n=$(basename "$d")
  lines=$(wc -l < "$d/SKILL.md")
  [ "$lines" -gt 150 ] && echo "WARN 150 lines exceeded: $n ($lines)"
done

if [ "$fail" -eq 0 ]; then echo 'VALIDATE OK'; else echo 'VALIDATE FAILED'; exit 1; fi
